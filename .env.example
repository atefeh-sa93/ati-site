# Public URL of the deployed site (canonical URLs, Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Path prefix when hosted under a sub-folder (GitHub Pages: /<repo>). Leave empty locally.
NEXT_PUBLIC_BASE_PATH=

# Optional: a GitHub token (no scopes needed) to show your real contribution graph.
# Without it, the activity card shows sample data.
GITHUB_TOKEN=
